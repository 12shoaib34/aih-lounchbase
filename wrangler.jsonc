{
  "name": "aih-lounchbase",
  "minify": true,
  "main": "worker.ts",
  "triggers": { "crons": ["*/5 * * * *"] },
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "aih-launchbase-private-files" }],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" }
}
